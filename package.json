{
    "name": "cookhound",
    "version": "1.3.14",
    "type": "module",
    "private": true,
    "workspaces": [
        "libs/*"
    ],
    "scripts": {
        "dev": "next dev",
        "build": "next build --webpack && npm run copy-static",
        "copy-static": "node scripts/copy-standalone.js",
        "start": "node .next/standalone/server.js",
        "dev-worker": "tsx src/server/queues/runtime/worker.ts",
        "prepare": "husky",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "typecheck": "tsc --noEmit",
        "lint": "prettier --write . && eslint",
        "lint:check": "eslint .",
        "format:check": "prettier --check .",
        "migrate": "npx prisma migrate dev --name init",
        "generate": "npx prisma generate --sql",
        "setup-typesense": "node scripts/setup-typesense-keys.js",
        "seed": "npx prisma db seed",
        "redis:flush": "node scripts/flush-redis.js"
    },
    "dependencies": {
        "@babel/runtime": "^7.28.6",
        "@prisma/adapter-pg": "7.10.0",
        "@prisma/client": "7.10.0",
        "@tanstack/react-query": "^5.101.2",
        "argon2": "^0.45.1",
        "bullmq": "^5.81.5",
        "class-transformer": "^0.5.1",
        "cookie": "^2.0.1",
        "dotenv": "^17.4.2",
        "framer-motion": "^13.4.0",
        "ioredis": "^6.0.0",
        "next": "16.3.5",
        "openai": "^7.17.0",
        "pg": "^8.23.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-easy-sort": "^1.8.0",
        "react-image-crop": "^11.1.2",
        "reflect-metadata": "^0.2.2",
        "server-only": "^0.0.1",
        "typesense": "^2.1.0",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0",
        "zod": "^4.6.5",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@svgr/webpack": "^8.1.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^22.9.0",
        "@types/pg": "^8.23.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.54.0",
        "@typescript-eslint/parser": "^8.54.0",
        "eslint": "^10.10.0",
        "eslint-config-next": "^16.3.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-cookhound": "workspace:^",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^15.2.10",
        "postcss": "^8.5.28",
        "prettier": "^3.9.7",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "prisma": "7.10.0",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.10",
        "typescript": "6.0.3",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^2.1.1"
    },
    "resolutions": {
        "pg": "^8.23.0",
        "@types/pg": "^8.23.0"
    },
    "browserslist": [
        "defaults and fully supports es6-module",
        "maintained node versions"
    ],
    "packageManager": "yarn@4.18.0"
}
